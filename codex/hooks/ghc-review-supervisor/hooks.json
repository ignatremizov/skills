{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/ghc_review_supervisor_session_start.py",
            "timeout": 10,
            "statusMessage": "ghc review supervisor flow context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/ghc_review_supervisor_stop.py",
            "timeout": 10,
            "statusMessage": "ghc review supervisor completion gate"
          }
        ]
      }
    ]
  }
}
