{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/supervisor_hardening_session_start.py",
            "timeout": 10,
            "statusMessage": "supervisor hardening flow context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/supervisor_hardening_stop.py",
            "timeout": 10,
            "statusMessage": "supervisor hardening completion gate"
          }
        ]
      }
    ]
  }
}
