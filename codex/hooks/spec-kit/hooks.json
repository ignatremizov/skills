{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/spec_kit_session_start.py",
            "timeout": 10,
            "statusMessage": "spec-kit phase preflight"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/spec_kit_stop.py",
            "timeout": 10,
            "statusMessage": "spec-kit completion gate"
          }
        ]
      }
    ]
  }
}
